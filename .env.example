# ── App / Auth ──────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public origin of the app (no trailing slash)
BETTER_AUTH_URL=http://localhost:3000

# ── Database (Neon Postgres) ────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# ── Redis (Upstash) ─────────────────────────────────────────────────────────
UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=

# ── Blob storage (Vercel Blob) ──────────────────────────────────────────────
# Used by next/image remotePatterns and upload action
BLOB_BASE_URL=https://xxxx.public.blob.vercel-storage.com
BLOB_READ_WRITE_TOKEN=

# ── Email (Resend) ──────────────────────────────────────────────────────────
RESEND_API_KEY=re_xxxx

# ── AI (Vercel AI Gateway) ──────────────────────────────────────────────────
# Used by summarizeArticle on create/update
AI_GATEWAY_API_KEY=

# ── Cron ────────────────────────────────────────────────────────────────────
# Bearer token for /api/summary (weekly summary backfill). Required outside dev.
CRON_SECRET=

# ── Optional / platform ─────────────────────────────────────────────────────
# Set automatically on Vercel; used for celebration email article links
# VERCEL_URL=

# ── E2E (Playwright) — optional, defaults shown ─────────────────────────────
# E2E_USER_EMAIL=e2e@wikiflow.test
# E2E_USER_PASSWORD=e2e-test-password-123
# E2E_USER_NAME=E2E Tester
# BASE_URL=http://localhost:3000
# PORT=3000
